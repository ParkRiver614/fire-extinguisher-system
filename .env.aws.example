# AWS 서버에 docker-compose.aws.yml과 함께 올릴 때, 이 파일을 복사해서 .env.aws로 저장 후 값 채우기
# (docker compose는 -f docker-compose.aws.yml --env-file .env.aws 로 실행)

# DB - 학과 서버와 다른, 새로 만든 강한 값으로 채울 것
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=

# 실제 값은 .env.aws에 보관. 환경마다 다른 값을 쓸 것(학과 서버와 공유 금지)
SECRET_KEY=
DEVICE_API_KEY=

# AWS 인스턴스에 붙인 도메인 또는 퍼블릭 IP (프론트 빌드 시 박히는 값)
API_BASE_URL=https://your-aws-domain-or-ip:8000

# API_BASE_URL은 두 곳에 쓰인다:
#  1) 프론트 빌드 시 JS에 박히는 API 주소 (VITE_API_BASE_URL)
#  2) 백엔드가 스냅샷 URL을 만들 때 쓰는 절대 주소 (PUBLIC_BASE_URL)
# 비워두면 백엔드가 학과 서버 주소를 기본값으로 써서 상세 화면 사진이 깨진다.

# 관리자 웹이 열리는 주소(스킴+호스트+포트). API가 CORS로 허용할 출처다.
# 비워두면 localhost만 허용되어 배포된 웹에서 API 호출이 전부 막힌다.
FRONT_ORIGIN=http://your-aws-domain-or-ip:8006
